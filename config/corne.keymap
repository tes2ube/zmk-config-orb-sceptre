    keymap {
        compatible = "zmk,keymap";

        home {
            bindings = <
&d_cvk    &dQuoDbq      &dComCal       &dPrdCar      &kp R          &kp T          &kp Y       &kp U          &kp I         &kp O          &kp P            &dFshBsh
&d_xvk    &ht_L LGUI A  &ht_L LCTRL S  &ht_L LALT D  &ht_L LSHFT F  &kp G          &kp H       &ht_R RSHFT J  &ht_R RALT K  &ht_R RCTRL L  &ht_R RGUI SEMI  &dDshAt
&dAndPer  &dSemCol      &kp X          &kp C         &kp V          &kp B          &kp N       &kp M          &kp COMMA     &kp DOT        &kp FSLH         &dQstExc
                                       &mt_R 3 DEL   &mt_L 4 TAB    &key_repeat    &kp RETURN  &mt_R 3 SPACE  &kp BSPC
            >;

            label = "spy|qrl";
        };

        macmode {
            bindings = <
&trans  &trans         &trans         &trans  &trans  &trans    &trans  &trans  &trans  &trans         &trans            &trans
&trans  &ht_L LCTRL A  &ht_L LMETA S  &trans  &trans  &trans    &trans  &trans  &trans  &ht_R RMETA L  &ht_R RCTRL SEMI  &trans
&trans  &trans         &trans         &trans  &trans  &trans    &trans  &trans  &trans  &trans         &trans            &trans
                                      &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "macmode";
        };

        wilber {
            bindings = <
&ht_W X U          &ht_W V P      &ht_W DOT G    &ht_W T S     &ht_W N O      &ht_W B M       &trans  &trans  &trans  &trans  &trans  &trans
&ht_W LS(Q) H      &ht_W LMETA K  &ht_W LCTRL A  &ht_W LALT D  &ht_W LSHFT L  &ht_W Q SEMI    &trans  &trans  &trans  &trans  &trans  &trans
&ht_W SLASH COMMA  &ht_W EXCL I   &ht_W LBRC F   &ht_W W R     &ht_W E J      &ht_W C Y       &trans  &trans  &trans  &trans  &trans  &trans
                                                 &trans        &spc_tab       &trans          &trans  &trans  &trans
            >;
        };

        num-sys {
            bindings = <
&kp LBKT  &dQuoDbq   &kp KP_N7          &kp KP_N8         &kp KP_N9          &kp STAR    &none   &kp C_RW            &kp C_STOP       &kp C_FF            &kp C_BRI_UP          &none
&kp APOS  &kp E      &ht_L LCTRL KP_N4  &ht_L LALT KP_N5  &ht_L LSHFT KP_N6  &kp RBRC    &none   &ht_R RSHFT C_PREV  &ht_R RALT C_PP  &ht_R RCTRL C_NEXT  &ht_R RMETA C_BRI_DN  &none
&kp RET   &kp KP_N0  &kp KP_N1          &kp KP_N2         &kp KP_N3          &none       &none   &kp C_VOL_DN        &kp C_MUTE       &kp C_VOL_UP        &none                 &none
                                        &to 0             &trans             &trans      &trans  &trans              &trans
            >;

            label = "num|sys";
        };

        nav-func {
            bindings = <
&mt PSCRN LC(PSCRN)  &kp LC(LEFT_ARROW)      &kp UP    &kp LC(RIGHT_ARROW)      &kp LC(SLASH)         &kp LC(LS(SLASH))    &none   &kp F9          &kp F10             &kp F11         &kp F12         &none
&m_retup             &kp LEFT                &kp DOWN  &kp RIGHT                &ht_L LSHFT LS(HOME)  &kp LS(END)          &none   &ht_R RSHFT F5  &ht_R RIGHT_ALT F6  &ht_R RCTRL F7  &ht_R RMETA F8  &none
&kp LC(COMMA)        &kp LC(LS(LEFT_ARROW))  &none     &kp LS(LC(RIGHT_ARROW))  &kp PG_UP             &kp PG_DN            &none   &kp F1          &kp F2              &kp F3          &kp F4          &none
                                                       &to 0                    &trans                &trans               &trans  &trans          &trans
            >;

            label = "nav|func";
        };

        macnav {
            bindings = <
&trans  &kp LA(LEFT)      &trans  &kp LA(RIGHT)      &kp LG(SLASH)  &kp LS(LG(SLASH))    &trans  &trans  &trans  &trans          &trans          &trans
&trans  &trans            &trans  &trans             &trans         &trans               &trans  &trans  &trans  &ht_R RMETA F7  &ht_R RCTRL F8  &trans
&trans  &kp LA(LS(LEFT))  &trans  &kp LA(LS(RIGHT))  &trans         &trans               &trans  &trans  &trans  &trans          &trans          &trans
                                  &to 1              &trans         &trans               &trans  &trans  &trans
            >;

            label = "macnav";
        };

        home-gaming {
            bindings = <
&kp EQUAL  &kp Q  &kp W  &kp E   &kp R   &kp T     &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LBKT
&kp SQT    &kp A  &kp S  &kp D   &kp F   &kp G     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp MINUS  &kp Z  &kp X  &kp C   &kp V   &kp B     &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp EXCL
                         &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "vidjo";
        };

        system {
            bindings = <
&none  &sys_reset   &bootloader  &bt BT_CLR   &studio_unlock  &none    &none  &studio_unlock  &bt BT_CLR   &bootloader  &sys_reset   &none
&none  &mLab_reset  &mLab_boot   &mLab_btclr  &mLab_studio    &none    &none  &mLab_studio    &mLab_btclr  &mLab_boot   &mLab_reset  &none
&none  &none        &none        &none        &none           &none    &none  &none           &none        &none        &none        &none
                                 &to 0        &none           &none    &none  &none           &to 0
            >;

            label = "sys";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        macmode {
            if-layers = <1 4>;
            then-layer = <5>;
        };
    };
};
