            tapping-term-ms = <225>;
        };

        ht_W: ht_W {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_W";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <110>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 36 37>;
            require-prior-idle-ms = <50>;
        };

        mdt_L: mdt_L {
            compatible = "zmk,behavior-hold-tap";
            label = "MDT_L";
            bindings = <&mo>, <&gresc>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 41 40 37>;
            hold-trigger-on-release;
        };

        spc_tab: spc_tab {
            compatible = "zmk,behavior-mod-morph";
            label = "SPC_TAB";
            bindings = <&mm_L 4 SPACE>, <&kp TAB>;

            #binding-cells = <0>;
            keep-mods = <(MOD_LALT)>;
            mods = <(MOD_LALT)>;
        };

        mm_L: mm_L {
            compatible = "zmk,behavior-hold-tap";
            label = "MM_L";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 41 40 37>;
            hold-trigger-on-release;
        };
