    macros {
        ms_wrkD: ms_wrkD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp LS(C) &kp LS(D) &kp LS(O) &kp LS(V) &kp LS(G) &kp LS(L) &kp LS(U)>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N3 &kp O &kp S &kp A &kp O &kp G &kp L &kp U &kp N6 &kp Y &kp P &kp A &kp L &kp A &kp U &kp A &kp L &kp N8 &kp I &kp O &kp G &kp SEMI>;

            label = "MS_WRKD";
        };

        ms_wrkQ: ms_wrkQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp J &kp E &kp R &kp K &kp I &kp N &kp G>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N3 &kp R &kp O &kp A &kp R &kp I &kp N &kp G &kp N6 &kp F &kp L &kp A &kp N &kp A &kp G &kp A &kp N &kp N8 &kp C &kp R &kp I &kp S>;

            label = "MS_WRKQ";
        };

        ms_mac: ms_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SEMI &kp J &kp D &kp D &kp L &kp N6 &kp COLON &kp LT &kp LS(D) &kp LS(O) &kp GT &kp LS(D) &kp N9 &kp SEMI &kp K &kp O &kp A &kp L &kp U &kp D &kp O &kp N6 &kp C &kp G &kp L &kp B>;
            label = "MS_MAC";
        };

        m_2cmd: m_2cmd {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>;

            label = "M_2CMD";
        };

        m_retup: m_retup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(RET) &kp UP>;
            label = "M_RETUP";
        };

        ms_phnx: ms_rphe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp FSLH &kp D &kp V &kp G &kp D &kp P &kp N7 &kp R &kp S &kp P &kp A &kp O &kp G &kp K &kp T &kp N4 &kp LS(U) &kp LS(A) &kp LS(M) &kp LS(M) &kp LS(D) &kp LS(O) &kp N4 &kp N &kp G &kp S &kp K &kp A>;
            label = "MS_RPHE";
        };

        m_2tabto0: m_2tabto0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp TAB &to 0>;

            label = "M_2TABTO0";
        };

        m_xv: m_xv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LC(B)>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp LC(PERIOD)>;

            label = "M_XV";
        };

        m_cv: m_cv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LC(I)>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp LC(PERIOD)>;

            label = "M_CV";
        };

        mLab_studio: mLab_studio {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp L &kp H &kp D &kp B &kp SPACE &kp SQT &kp SPACE &kp SEMI &kp K &kp F &kp H &kp G &kp S &kp SPACE &kp F &kp L &kp P &kp S &kp I &kp V>;
            label = "MLAB_STUDIO";
        };

        mLab_btclr: mLab_btclr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp M &kp G &kp H &kp H &kp P &kp D &kp SPACE &kp SQT &kp SPACE &kp N &kp K &kp DQT &kp I &kp P &kp O>;
            label = "MLAB_BTCLR";
        };

        mLab_boot: mLab_boot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp O &kp G &kp L &kp U &kp SPACE &kp SQT &kp SPACE &kp N &kp S &kp S &kp K &kp P &kp S &kp A &kp H &kp D &kp O>;
            label = "MLAB_BOOT";
        };

        mLab_reset: mLab_reset {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp G &kp L &kp V &kp T &kp SPACE &kp SQT &kp SPACE &kp SEMI &kp T &kp SEMI &kp SPACE &kp O &kp D &kp SEMI &kp D &kp K>;
            label = "MLAB_RESET";
        };
    };

    combos {
