            label = "D_XVK";
            #binding-cells = <0>;
            bindings = <&ht_xvk 0 HASH>, <&kp STAR>;

            tapping-term-ms = <225>;
        };

        d_cvk: d_cvk {
            compatible = "zmk,behavior-tap-dance";
            label = "D_CVK";
            #binding-cells = <0>;
