#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    flavor = "balanced";
    tapping-term-ms = <190>;
};

&mt { flavor = "balanced"; };

&key_repeat { usage-pages = <HID_USAGE_KEY HID_USAGE_CONSUMER>; };

/* Homerow mods

#define QUICK_TAP_MS 175
#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                                  // thumbs

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_BEHAVIOR(NAME, hold_tap, \
        flavor = "balanced"; \
        tapping-term-ms = <280>; \
        quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <150>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )
MAKE_HRM(lt, &kp, &kp, KEYS_R THUMBS)  // left-hand HRMs
MAKE_HRM(lt, &kp, &kp, KEYS_L THUMBS)  // right-hand HRMs

MAKE_HRM(lt_repeat, &kp, &key_repeat, KEYS_R THUMBS)  // used for HRM-combo
MAKE_HRM(lt_lpar_lt, &kp, &lpar_lt, KEYS_L THUMBS)    // "    "   "   "
MAKE_HRM(lt_rpar_gt, &kp, &rpar_gt, KEYS_L THUMBS)    // "    "   "   "

*/

/ {
    behaviors {
        ht_L: ht_L {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_L";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <155>;
            quick-tap-ms = <135>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 36 37>;
            hold-trigger-on-release;
        };

        ht_R: ht_R {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_R";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <155>;
            quick-tap-ms = <135>;
            require-prior-idle-ms = <125>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37>;
            hold-trigger-on-release;
        };

        dQuoDbq: dQuoDbq {
            compatible = "zmk,behavior-tap-dance";
            label = "DQUODBQ";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp LS(Q)>;

            tapping-term-ms = <275>;
        };

        dComCal: dComCal {
            compatible = "zmk,behavior-tap-dance";
            label = "DCOMCAL";
            #binding-cells = <0>;
            bindings = <&kp W>, <&kp LS(W)>;

            tapping-term-ms = <275>;
        };

        dPrdCar: dPrdCar {
            compatible = "zmk,behavior-tap-dance";
            label = "DPRDCAR";
            #binding-cells = <0>;
            tapping-term-ms = <275>;
            bindings = <&kp E>, <&kp LS(E)>;
        };

        dlP: dlP {
            compatible = "zmk,behavior-tap-dance";
            label = "DLP";
            #binding-cells = <0>;
            bindings = <&kp R>, <&kp LS(R)>;

            tapping-term-ms = <275>;
        };

        dlY: dlY {
            compatible = "zmk,behavior-tap-dance";
            label = "DLY";
            #binding-cells = <0>;
            bindings = <&kp T>, <&kp LS(T)>;

            tapping-term-ms = <300>;
        };

        dl_htA: dl_htA {
            compatible = "zmk,behavior-tap-dance";
            label = "DL_HTA";
            #binding-cells = <0>;
            bindings = <&ht_L LGUI A>, <&kp LS(A)>;

            tapping-term-ms = <250>;
        };

        dl_htO: dl_htO {
            compatible = "zmk,behavior-tap-dance";
            label = "DL_HTO";
            #binding-cells = <0>;
            bindings = <&ht_L LCTRL S>, <&kp LS(S)>;

            tapping-term-ms = <250>;
        };

        dl_htE: dl_htE {
            compatible = "zmk,behavior-tap-dance";
            label = "DL_HTE";
            #binding-cells = <0>;
            bindings = <&ht_L LALT D>, <&kp LS(D)>;

            tapping-term-ms = <250>;
        };

        dl_htU: dl_htU {
            compatible = "zmk,behavior-tap-dance";
            label = "DL_HTU";
            #binding-cells = <0>;
            bindings = <&ht_L LSHFT F>, <&kp LS(F)>;

            tapping-term-ms = <250>;
        };

        dHshAst: dHshAst {
            compatible = "zmk,behavior-tap-dance";
            label = "DHSHAST";
            #binding-cells = <0>;
            bindings = <&kp HASH>, <&kp STAR>;

            tapping-term-ms = <350>;
        };

        dAndPer: dAndPer {
            compatible = "zmk,behavior-tap-dance";
            label = "DANDPER";
            #binding-cells = <0>;
            bindings = <&kp AMPS>, <&kp PERCENT>;

            tapping-term-ms = <350>;
        };

        dSemCol: dSemCol {
            compatible = "zmk,behavior-tap-dance";
            label = "DSEMCOL";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp LS(LBKT)>;

            tapping-term-ms = <275>;
        };

        dlQ: dlQ {
            compatible = "zmk,behavior-tap-dance";
            label = "DLQ";
            #binding-cells = <0>;
            bindings = <&kp X>, <&kp LS(X)>;

            tapping-term-ms = <275>;
        };

        dlJ: dlJ {
            compatible = "zmk,behavior-tap-dance";
            label = "DLJ";
            #binding-cells = <0>;
            bindings = <&kp C>, <&kp LS(C)>;

            tapping-term-ms = <275>;
        };

        dlK: dlK {
            compatible = "zmk,behavior-tap-dance";
            label = "DLK";
            #binding-cells = <0>;
            bindings = <&kp V>, <&kp LS(V)>;

            tapping-term-ms = <275>;
        };

        dlX: dlX {
            compatible = "zmk,behavior-tap-dance";
            label = "DLX";
            #binding-cells = <0>;
            bindings = <&kp B>, <&kp LS(B)>;

            tapping-term-ms = <300>;
        };

        dlI: dlI {
            compatible = "zmk,behavior-tap-dance";
            label = "DLI";
            #binding-cells = <0>;
            bindings = <&kp G>, <&kp LS(G)>;

            tapping-term-ms = <300>;
        };

        mt_L: mt_L {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_L";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <145>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 41 40 37>;
            hold-trigger-on-release;
        };

        mt_R: mt_R {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_R";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <175>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 37 40 36>;
            hold-trigger-on-release;
        };
    };

    macros {
        ms_wrkD: ms_wrkD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp COLON &kp LS(K) &kp LS(G) &kp LS(I) &kp LS(V) &kp LS(D) &kp LS(O) &kp N9 &kp Y &kp O &kp T &kp D &kp O &kp N7 &kp G &kp L &kp H &kp G &kp A &kp N9 &kp SEMI &kp K &kp A &kp V &kp D &kp SEMI>;
            label = "MS_WRKD";
            tap-ms = <30>;
        };

        ms_wrkQ: ms_wrkQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(S) &kp LS(T) &kp LS(I) &kp LS(C) &kp LS(K) &kp LS(E) &kp LS(R) &kp N9 &kp F &kp R &kp Y &kp E &kp R &kp N7 &kp I &kp N &kp D &kp I &kp A &kp N9 &kp S &kp T &kp A &kp K &kp E &kp S>;
            label = "MS_WRKQ";
            tap-ms = <60>;
        };

        ms_mac: ms_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SEMI &kp J &kp D &kp D &kp L &kp N6 &kp COLON &kp LT &kp LS(D) &kp LS(O) &kp GT &kp LS(D) &kp N9 &kp SEMI &kp K &kp O &kp A &kp L &kp U &kp D &kp O &kp N6 &kp C &kp G &kp L &kp B>;
            label = "MS_MAC";
            tap-ms = <60>;
        };

        m_2cmd: m_2cmd {
            compatible = "zmk,behavior-macro-two-param";
            #binding-cells = <2>;
            bindings =
                <&macro_param_1to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_param_2to1>,
                <&macro_tap>,
                <&kp MACRO_PLACEHOLDER>;

            label = "M_2CMD";
        };

        m_xv: m_xv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LC(B)>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp LC(DOT)>;

            label = "M_XV";
        };

        m_cv: m_cv {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LC(I)>,
                <&macro_pause_for_release>,
                <&macro_tap>,
                <&kp LC(DOT)>;

            label = "M_CV";
        };

        m_retup: m_retup {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(RET) &kp UP>;
            label = "M_RETUP";
        };

        ms_phnx: ms_rphe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp FSLH &kp D &kp V &kp G &kp D &kp P &kp N7 &kp R &kp S &kp P &kp A &kp O &kp G &kp K &kp T &kp N4 &kp LS(U) &kp LS(A) &kp LS(M) &kp LS(M) &kp LS(D) &kp LS(O) &kp N4 &kp N &kp G &kp S &kp K &kp A>;
            label = "MS_RPHE";
        };

        m_2tabto0: m_2tabto0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap>, <&kp TAB &to 0>;

            label = "M_2TABTO0";
        };
    };

    combos {
        compatible = "zmk,combos";

        c_parL {
            bindings = <&kp LPAR>;
            key-positions = <1 2>;
        };

        c_parR {
            bindings = <&kp RPAR>;
            key-positions = <3 4>;
        };

        c_bktL {
            bindings = <&kp MINUS>;
            key-positions = <7 8>;
        };

        c_bktR {
            bindings = <&kp EQUAL>;
            key-positions = <10 9>;
        };

        c_home {
            bindings = <&kp HOME>;
            key-positions = <15 16>;
        };

        c_end {
            bindings = <&kp END>;
            key-positions = <16 17>;
            require-prior-idle-ms = <200>;
        };

        c_meta {
            bindings = <&kp LMETA>;
            key-positions = <13 22>;
            layers = <0 1 2 3 2>;
            require-prior-idle-ms = <200>;
            timeout-ms = <28>;
        };

        c_dol {
            bindings = <&kp DLLR>;
            key-positions = <16 4>;
        };

        c_pipe {
            bindings = <&kp PIPE>;
            key-positions = <5 17>;
        };

        c_prcnt {
            bindings = <&kp PRCNT>;
            key-positions = <4 15 9>;
        };

        c_at {
            bindings = <&kp AT>;
            key-positions = <13 20>;
            require-prior-idle-ms = <300>;
            layers = <0 1 2>;
        };

        c_us {
            bindings = <&kp LS(APOS)>;
            key-positions = <22 23>;
        };

        c_pgup {
            bindings = <&kp PAGE_UP>;
            key-positions = <30 31>;
            require-prior-idle-ms = <200>;
        };

        c_pgdn {
            bindings = <&kp PG_DN>;
            key-positions = <31 32>;
            require-prior-idle-ms = <200>;
        };

        c_caps {
            bindings = <&kp CAPSLOCK>;
            key-positions = <17 18>;
            require-prior-idle-ms = <400>;
            layers = <0 2>;
        };

        c_cut {
            bindings = <&kp LC(B)>;
            key-positions = <25 27>;
        };

        c_paste {
            bindings = <&kp LC(DOT)>;
            key-positions = <16 14>;
            require-prior-idle-ms = <350>;
            timeout-ms = <30>;
        };

        c_copy {
            bindings = <&kp LC(I)>;
            key-positions = <13 15>;
            timeout-ms = <21>;
            require-prior-idle-ms = <350>;
        };

        c_esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
        };

        c_lgamlok {
            bindings = <&tog 1>;
            key-positions = <41 40>;
            layers = <0 1>;
            require-prior-idle-ms = <1000>;
        };

        c_ltroub {
            bindings = <&to 4>;
            key-positions = <24 12 38>;
            require-prior-idle-ms = <3000>;
        };

        c_ltroubR {
            bindings = <&to 4>;
            key-positions = <39 35 23>;
            require-prior-idle-ms = <3000>;
        };

        cs_dwrk {
            bindings = <&ms_wrkD>;
            key-positions = <17 13 20 22>;
            require-prior-idle-ms = <3000>;
            timeout-ms = <100>;
        };

        c_qwrk {
            bindings = <&ms_wrkQ>;
            key-positions = <20 22 26 13>;
            require-prior-idle-ms = <3000>;
            timeout-ms = <100>;
        };

        cs_fox {
            bindings = <&ms_mac>;
            key-positions = <4 31 13 8>;
            timeout-ms = <100>;
            require-prior-idle-ms = <3000>;
        };

        c_dskl {
            bindings = <&kp LG(LC(LEFT_ARROW))>;
            key-positions = <0 1 37>;
        };

        c_deskr {
            bindings = <&kp LG(LC(RIGHT_ARROW))>;
            key-positions = <4 5 37>;
        };

        c_sum {
            bindings = <&kp RBRC>;
            key-positions = <16 22 31>;
        };

        c_eq {
            bindings = <&kp RBKT>;
            key-positions = <26 15 16>;
        };

        c_pow {
            bindings = <&kp CARET>;
            key-positions = <4 14 32>;
        };

        c_ast {
            bindings = <&kp STAR>;
            key-positions = <13 22 20>;
        };

        c_qp {
            bindings = <&kp P>;
            key-positions = <1 37>;
        };

        c_wo {
            bindings = <&kp O>;
            key-positions = <2 37>;
        };

        c_ei {
            bindings = <&kp I>;
            key-positions = <3 37>;
        };

        c_ru {
            bindings = <&kp U>;
            key-positions = <4 37>;
        };

        c_ty {
            bindings = <&kp Y>;
            key-positions = <5 37>;
        };

        c_min {
            bindings = <&kp SQT>;
            key-positions = <12 37>;
        };

        c_asemi {
            bindings = <&kp SEMI>;
            key-positions = <13 37>;
        };

        c_sl {
            bindings = <&kp L>;
            key-positions = <14 37>;
        };

        c_dk {
            bindings = <&kp K>;
            key-positions = <15 37>;
        };

        c_fj {
            bindings = <&kp J>;
            key-positions = <16 37>;
        };

        c_hg {
            bindings = <&kp H>;
            key-positions = <17 37>;
        };

        c_excl {
            bindings = <&kp EXCL>;
            key-positions = <24 37>;
        };

        c_zslsh {
            bindings = <&kp FSLH>;
            key-positions = <25 37>;
        };

        c_xdot {
            bindings = <&kp DOT>;
            key-positions = <26 37>;
        };

        c_ccom {
            bindings = <&kp COMMA>;
            key-positions = <27 37>;
        };

        c_vm {
            bindings = <&kp M>;
            key-positions = <28 37>;
        };

        c_bn {
            bindings = <&kp N>;
            key-positions = <29 37>;
        };

        c_space {
            bindings = <&kp SPACE>;
            key-positions = <27 28>;
        };

        c_btx1 {
            bindings = <&bt BT_DISC 0>;
            key-positions = <38 25>;
        };

        c_btx2 {
            bindings = <&bt BT_DISC 1>;
            key-positions = <38 26>;
        };

        c_btx3 {
            bindings = <&bt BT_DISC 2>;
            key-positions = <38 27>;
        };

        c_btx4 {
            bindings = <&bt BT_DISC 3>;
            key-positions = <38 28>;
        };

        c_btx5 {
            bindings = <&bt BT_DISC 4>;
            key-positions = <38 29>;
        };

        c_bksp {
            bindings = <&kp BSPC>;
            key-positions = <26 25>;
        };

        c_ins {
            bindings = <&kp INSERT>;
            key-positions = <33 34>;
        };

        c_ret {
            bindings = <&kp RET>;
            key-positions = <29 28>;
        };

        cs_phx {
            bindings = <&ms_phnx>;
            key-positions = <19 4 29 21>;
            require-prior-idle-ms = <3000>;
            timeout-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        home {
            bindings = <
&none     &dQuoDbq  &dComCal  &dPrdCar     &dlP         &dlY           &kp Y       &kp U          &kp I         &kp O          &kp P            &none
&dHshAst  &dl_htA   &dl_htO   &dl_htE      &dl_htU      &dlI           &kp H       &ht_R RSHFT J  &ht_R RALT K  &ht_R RCTRL L  &ht_R RGUI SEMI  &kp SQT
&dAndPer  &dSemCol  &dlQ      &dlJ         &dlK         &dlX           &kp N       &kp M          &kp COMMA     &kp PERIOD     &kp FSLH         &kp EXCL
                              &mt_R 2 DEL  &mt_L 3 TAB  &key_repeat    &kp RETURN  &mt_R 2 SPACE  &kp BSPC
            >;

            label = "spy|qrl";
        };

        home-gaming {
            bindings = <
&kp EQUAL  &kp Q  &kp W  &kp E   &kp R   &kp T     &kp Y   &kp U   &kp I      &kp O    &kp P     &kp LBKT
&kp SQT    &kp A  &kp S  &kp D   &kp F   &kp G     &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp MINUS  &kp Z  &kp X  &kp C   &kp V   &kp B     &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp EXCL
                         &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "vidjo";
        };

        num-sys {
            bindings = <
&kp LCTRL  &none   &kp N7          &kp N8         &kp N9          &none     &none   &kp C_RW            &kp C_STOP       &kp C_FF            &kp C_BRI_UP          &rgb_ug RGB_BRI
&kp PRCNT  &none   &ht_L LCTRL N4  &ht_L LALT N5  &ht_L LSHFT N6  &none     &none   &ht_R RSHFT C_PREV  &ht_R RALT C_PP  &ht_R RCTRL C_NEXT  &ht_R RMETA C_BRI_DN  &rgb_ug RGB_BRD
&none      &kp N0  &kp N1          &kp N2         &kp N3          &none     &none   &kp C_VOL_DN        &kp C_MUTE       &kp C_VOL_UP        &ext_power EP_ON      &rgb_ug RGB_ON
                                   &to 0          &trans          &trans    &trans  &trans              &trans
            >;

            label = "num|sys";
        };

        nav-func {
            bindings = <
&none          &kp LC(LEFT_ARROW)      &kp UP    &kp LC(RIGHT_ARROW)      &kp LC(SLASH)         &kp LC(LS(SLASH))    &mt PSCRN LC(PSCRN)  &kp F9          &kp F10             &kp F11         &kp F12         &none
&m_retup       &kp LEFT                &kp DOWN  &kp RIGHT                &ht_L LSHFT LS(HOME)  &kp LS(END)          &none                &ht_R RSHFT F5  &ht_R RIGHT_ALT F6  &ht_R RCTRL F7  &ht_R RMETA F8  &none
&kp LC(COMMA)  &kp LC(LS(LEFT_ARROW))  &none     &kp LS(LC(RIGHT_ARROW))  &none                 &none                &none                &kp F1          &kp F2              &kp F3          &kp F4          &none
                                                 &to 0                    &trans                &trans               &trans               &trans          &trans
            >;

            label = "nav|func";
        };

        system {
            bindings = <
&none  &sys_reset  &bootloader  &bt BT_CLR  &studio_unlock  &none    &none  &studio_unlock  &bt BT_CLR  &bootloader  &sys_reset  &none
&none  &trans      &trans       &trans      &trans          &none    &none  &trans          &trans      &trans       &trans      &none
&none  &none       &none        &none       &none           &none    &none  &none           &none       &none        &none       &none
                                &to 0       &none           &none    &none  &none           &to 0
            >;

            label = "sys";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
